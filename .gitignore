output/
__pycache__/
*.pyc
.venv/
venv/
.guest_token_cache.json
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Tesseract language packs -- vendored binary assets (~3MB each), not source.
# See mahabhumi.py's _ocr_image docstring for how to fetch mar.traineddata.
tessdata/

# up_captcha_search.py's own result dumps -- diagnostic output, not source.
_up_captcha_*_result.txt

# igr_maharashtra_search.py's own result dumps -- same, diagnostic output.
_igr_maharashtra_*_result.txt

# captcha_solver.py's own persisted spend tracker -- local runtime state,
# not source; see captcha_usage_summary().
captcha_solve_usage.json

# Local API keys, read by captcha_solver.py's _load_dotenv_once() as a
# fallback when a Machine-level env var isn't visible to this process's
# own sandboxed execution environment -- never committed.
.env
